# ponytail: reduces build context size for airflow Dockerfile (context: .)
# Only excludes dirs the airflow Dockerfile doesn't COPY.
# Other builds (backend/, backend/ml/) use scoped context and ignore this file.
.git
.gitignore
.github
node_modules
frontend
terraform
*.md
.vscode
.idea
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
coverage
# Match nested env files too: `backend/.env` is inside the build context for
# the root-context Airflow image and was previously baked into it.
**/.env
**/.env.*
!**/.env.example
.DS_Store
.venv/
**/.venv/
*.log
htmlcov/
# Terraform state/plan files contain secrets and must never enter an image.
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/tfplan
**/.terraform/
