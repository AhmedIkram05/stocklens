{
  "name": "stocklens",
  "version": "1.0.0",
  "main": "frontend/index.ts",
  "scripts": {
    "start": "cd frontend && expo start",
    "android": "cd frontend && expo start --android",
    "ios": "cd frontend && expo start --ios",
    "graphql:codegen": "graphql-codegen --config codegen.yml",
    "typecheck": "tsc --noEmit",
    "test": "jest --config frontend/jest.config.js",
    "test:unit": "jest --config frontend/jest.config.js --testPathPattern='unit\\.test\\.(ts|tsx)$'",
    "test:integration": "jest --config frontend/jest.config.js --testPathPattern='integration\\.test\\.(ts|tsx)$'",
    "test:coverage": "jest --config frontend/jest.config.js --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/stack": "^7.11.2",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.9",
    "expo-haptics": "^15.0.7",
    "expo-image-manipulator": "^14.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "^17.0.9",
    "expo-random": "^14.0.1",
    "expo-secure-store": "~15.0.7",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "graphql-ws": "^6.3.0",
    "node-forge": "^1.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.7",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.12",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.4",
    "eslint-config-universe": "~15.0.3",
    "graphql": "^17.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^3.9.9",
    "test-renderer": "^1.1.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.2"
  },
  "private": true
}
