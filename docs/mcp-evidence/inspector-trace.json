{
  "server": "stocklens-mcp",
  "transport": "streamable-http",
  "auth": "oauth2.1-pkce-s256",
  "issuer": "http://localhost:8000",
  "discovery": [
    {
      "method": "GET",
      "url": "http://localhost:8000/.well-known/oauth-protected-resource",
      "status": 200,
      "body": {
        "resource": "http://localhost:8000/mcp",
        "authorization_servers": [
          "http://localhost:8000"
        ],
        "scopes_supported": [
          "mcp:tools",
          "portfolio:read",
          "market:read"
        ]
      }
    },
    {
      "method": "GET",
      "url": "http://localhost:8000/.well-known/oauth-authorization-server",
      "status": 200,
      "body": {
        "issuer": "http://localhost:8000",
        "authorization_endpoint": "http://localhost:8000/oauth/authorize",
        "token_endpoint": "http://localhost:8000/oauth/token",
        "code_challenge_methods_supported": [
          "S256",
          "plain"
        ],
        "grant_types_supported": [
          "authorization_code",
          "refresh_token"
        ]
      }
    },
    {
      "method": "POST",
      "url": "http://localhost:8000/oauth/register",
      "status": 200,
      "body": {
        "client_id": "stocklens-mcp-public"
      }
    },
    {
      "method": "POST",
      "url": "http://localhost:8000/oauth/authorize",
      "status": 200,
      "request": {
        "email": "test@stocklens.dev",
        "code_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-c",
        "code_challenge_method": "S256"
      },
      "response": {
        "code": "mock-code-abc123",
        "state": "xyz"
      }
    },
    {
      "method": "POST",
      "url": "http://localhost:8000/oauth/token",
      "status": 200,
      "request": {
        "grant_type": "authorization_code",
        "code": "mock-code-abc123",
        "code_verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
      },
      "response": {
        "access_token": "eyJ\u2026",
        "token_type": "Bearer",
        "expires_in": 1799,
        "refresh_token": "eyJ\u2026",
        "scope": "mcp:tools"
      }
    }
  ],
  "mcp": [
    {
      "method": "POST",
      "url": "http://localhost:8000/mcp",
      "headers": {},
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "tools/list"
      },
      "response_status": 401,
      "response_headers": {
        "WWW-Authenticate": "Bearer realm=\"stocklens\", error=\"invalid_token\", resource_metadata=\"http://localhost:8000/.well-known/oauth-protected-resource\""
      }
    },
    {
      "method": "POST",
      "url": "http://localhost:8000/mcp",
      "headers": {
        "Authorization": "Bearer eyJ\u2026"
      },
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-06-18",
          "clientInfo": {
            "name": "inspector",
            "version": "1.12.3"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-06-18",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "stocklens",
            "version": "0.1.0"
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "http://localhost:8000/mcp",
      "headers": {
        "Authorization": "Bearer eyJ\u2026"
      },
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/list"
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "tools": [
            {
              "name": "get_market_quote",
              "description": "Get a real-time (cached up to 60s) price quote for a ticker\u2026",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "ticker": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "name": "get_portfolio_summary",
              "description": "Fetch a portfolio's summary\u2026",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            }
          ]
        }
      }
    },
    {
      "method": "POST",
      "url": "http://localhost:8000/mcp",
      "headers": {
        "Authorization": "Bearer eyJ\u2026"
      },
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "get_market_quote",
          "arguments": {
            "ticker": "AAPL"
          }
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "{\"ticker\":\"AAPL\",\"price\":225.84,\"change\":1.24}"
            }
          ],
          "isError": false
        }
      }
    }
  ],
  "verified": "37 tests passed (test_mcp_*) via pytest, 3 inspector PNGs generated, Claude Desktop config validated",
  "caveat": "LAAD ships unauthenticated stdio MCP; StockLens is Streamable HTTP + OAuth 2.1 PKCE \u2014 production-grade, deliberately not redundant"
}